package: "com.android.wallpaper"
container: "system_ext"

flag {
    name: "wallpaper_restorer_flag"
    namespace: "customization_picker"
    description: "Enables wallpaper restorer when the flag is turned on."
    bug: "285047815"
}

flag {
    name: "enable_pack_theme_entry"
    namespace: "customization_picker"
    description: "Enable the entry of the theme."
    bug: "372344184"
}

flag {
    name: "new_creative_wallpaper_category"
    namespace: "customization_picker"
    description: "Add new column for the new creative wallpaper."
    bug: "381009822"
}

flag {
    name: "creative_wallpaper_field_collection_wallpaper"
    namespace: "customization_picker"
    description: "Add new field IsCollectionWallpaper for the new creative wallpaper."
    bug: "381009822"
}

flag {
   name: "compose_refactor_flag"
   namespace: "customization_picker"
   description: "Refactor pieces of picker UI into compose."
   bug: "391918848"
}

flag {
   name: "color_picker_update_flag"
   namespace: "customization_picker"
   description: "Update color picker with new UI and functionality, and integrate with ThemeService"
   bug: "391927276"
}

flag {
    name: "fullscreen_preview_flag"
    namespace: "customization_picker"
    description: "Enables full screen wallpaper preview"
    bug: "409100074"
}

flag {
    name: "desktop_ui_flag"
    namespace: "desktop_personalization"
    description: "Mouse, keyboard, large screen improvements for customization picker"
    bug: "415883086"
    metadata {
        purpose: PURPOSE_FEATURE
    }
}

flag {
    name: "adaptive_wallpaper_flag"
    namespace: "customization_picker"
    description: "Add wallpapers that change based on the system's theme"
    bug: "350781760"
    metadata {
        purpose: PURPOSE_FEATURE
    }
}

flag {
    name: "refactor_individual_picker_flag"
    namespace: "customization_picker"
    description: "Migrates the individual picker screen to use the recommended architecture, Compose WallpaperModel and CategoryModel "
    bug: "433284926"
}

flag {
    name: "refactor_wallpaper_preview_screen_flag"
    namespace: "customization_picker"
    description: "Refactor the wallpaper preview screen into Compose."
    bug: "423956081"
}
